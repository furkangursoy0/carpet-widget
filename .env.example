# ─── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.sceneva.com
NEXT_PUBLIC_MARKETING_URL=https://sceneva.com
NEXT_PUBLIC_WIDGET_SCRIPT_URL=https://app.sceneva.com/widget/widget.js

# ─── Supabase ────────────────────────────────────────────────────────
# Settings → API in Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── OpenAI (gpt-image) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_IMAGE_MODEL=gpt-image-1

# ─── Lemon Squeezy ──────────────────────────────────────────────────
LEMONSQUEEZY_API_KEY=eyJ...
LEMONSQUEEZY_STORE_ID=12345
LEMONSQUEEZY_WEBHOOK_SECRET=...
# Variant ID for the Growth plan ($99/mo, 1,000 previews)
LEMONSQUEEZY_GROWTH_VARIANT_ID=12345

# ─── Resend (email) ─────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@sceneva.com

# ─── Sentry (optional, recommended) ─────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── Plan limits ────────────────────────────────────────────────────
GROWTH_PLAN_MONTHLY_LIMIT=1000
