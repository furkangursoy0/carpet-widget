{
  "name": "sceneva-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run widget:build && next build",
    "start": "next start",
    "lint": "next lint",
    "widget:build": "esbuild widget/src/index.ts --bundle --minify --format=iife --target=es2020 --outfile=public/widget/widget.js",
    "widget:dev": "esbuild widget/src/index.ts --bundle --format=iife --target=es2020 --outfile=public/widget/widget.js --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "openai": "^4.67.3",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-email": "^3.0.1",
    "@react-email/components": "^0.0.25",
    "resend": "^4.0.0",
    "lucide-react": "^0.451.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8",
    "@sentry/nextjs": "^8.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
